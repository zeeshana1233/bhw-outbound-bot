# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bhw_bot
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration (OpenClaw)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# BHW Configuration
BHW_USERNAME=app_pilot
BHW_CHROME_PROFILE_PATH=/path/to/chrome/profile
BHW_SCRAPE_INTERVAL_MIN=600000
BHW_SCRAPE_INTERVAL_MAX=1200000
BHW_INBOX_CHECK_INTERVAL=300000

# WhatsApp Alerts (via CallMeBot — free, no account needed)
# Setup: Save +34 644 321 633 as a WhatsApp contact, then send the message:
#   "I allow callmebot to send me messages"
# You will receive your API key in reply within seconds.
WHATSAPP_ENABLED=true
WHATSAPP_ALERT_NUMBER=447912345678
CALLMEBOT_API_KEY=your_callmebot_api_key

# Bot Behavior Settings
MIN_DELAY_MS=2000
MAX_DELAY_MS=8000
TYPING_SPEED_MIN=50
TYPING_SPEED_MAX=150
MAX_FOLLOW_UPS=5
FOLLOW_UP_DAYS=7,14,21,28

# System Settings
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Safety — set to 'false' only when ready to go live (comments, DMs, follow-ups)
# Default is true (dry-run mode: generates & shows messages but does NOT send)
DRY_RUN=true
