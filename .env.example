# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bhw_bot
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration (OpenClaw)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# BHW Configuration
BHW_USERNAME=app_pilot
BHW_CHROME_PROFILE_PATH=/path/to/chrome/profile
BHW_SCRAPE_INTERVAL_MIN=600000
BHW_SCRAPE_INTERVAL_MAX=1200000
BHW_INBOX_CHECK_INTERVAL=300000

# Telegram Command Center (via Telegraf — official Bot API)
# ─────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → copy the token
# 2. Create a Telegram group, add the bot, give it admin rights
# 3. Get the group chat ID (use @userinfobot or check Telegram API)
# 4. Set the vars below and start the bot — no QR, no session files
# All commands AND alerts go to this group — one place for everything.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_GROUP_ID=-your_group_chat_id_here
# If Telegram is ISP-blocked on your server (e.g. Pakistan), set a proxy:
# TELEGRAM_PROXY_URL=http://user:pass@proxy-host:8080
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# Bot Behavior Settings
MIN_DELAY_MS=2000
MAX_DELAY_MS=8000
TYPING_SPEED_MIN=50
TYPING_SPEED_MAX=150
MAX_FOLLOW_UPS=5
FOLLOW_UP_DAYS=7,14,21,28

# System Settings
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Safety — set to 'false' only when ready to go live (comments, DMs, follow-ups)
# Default is true (dry-run mode: generates & shows messages but does NOT send)
DRY_RUN=true

# ── Threads Owner Outreach Module ──────────────────────────────────────────
# DMs the owners of existing BHW threads from a pre-seeded CSV list.
# Set OUTREACH_ENABLED=true to activate after seeding targets.csv
# Seed targets:  node scripts/seed-outreach-targets.js /path/to/targets.csv
OUTREACH_ENABLED=false
OUTREACH_DAILY_CAP=5                  # DMs to send per active window (per day)
OUTREACH_ACTIVE_START_UTC=15          # Window open  (15:00 UTC = 10:00 AM US Eastern)
OUTREACH_ACTIVE_END_UTC=7             # Window close ( 7:00 UTC =  2:00 AM US Eastern)
OUTREACH_WINDOW_JITTER_MINUTES=30     # ±jitter on window open time (anti-pattern detection)
OUTREACH_MIN_GAP_MINUTES=90           # Min minutes between any two DMs in a batch
OUTREACH_FOLLOWUP1_DAYS=3             # Day 3  follow-up
OUTREACH_FOLLOWUP2_DAYS=7             # Day 7  follow-up
OUTREACH_FOLLOWUP3_DAYS=14            # Day 14 follow-up

# Preview mode — AI generates DM+follow-ups, sends WA preview, marks target as 'previewed'
# (rotates to fresh targets daily). No BHW DM sent, no DB conversation rows written.
# Set to 'false' (and OUTREACH_ENABLED=true) when ready to send real DMs.
# To re-queue previewed targets: UPDATE outreach_targets SET status='pending' WHERE status='previewed';
OUTREACH_PREVIEW_MODE=false

# Test mode — bypasses active-window and scatter-delay timing gates (local dev only).
# ALWAYS set to 'false' on production server.
OUTREACH_TEST_MODE=false
