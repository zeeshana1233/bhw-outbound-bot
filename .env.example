# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bhw_bot
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration (OpenClaw)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# BHW Configuration
BHW_USERNAME=app_pilot
BHW_CHROME_PROFILE_PATH=/path/to/chrome/profile
BHW_SCRAPE_INTERVAL_MIN=600000
BHW_SCRAPE_INTERVAL_MAX=1200000
BHW_INBOX_CHECK_INTERVAL=300000

# WhatsApp Command Center (via whatsapp-web.js — unofficial login)
# ─────────────────────────────────────────────────────────────────
# 1. Start the bot: node src/index.js
# 2. Scan the QR code that appears with your phone:
#    WhatsApp → Settings → Linked Devices → Link a Device
# 3. Session is saved to .wwebjs_auth/ — never commit that folder
# 4. Create a WhatsApp group and add the linked number to it
# 5. Set the EXACT group name below (must match perfectly, case-sensitive)
# All commands AND alerts go to this group — one place for everything.
WA_GROUP_NAME=Bitbash BHW Bot

# Bot Behavior Settings
MIN_DELAY_MS=2000
MAX_DELAY_MS=8000
TYPING_SPEED_MIN=50
TYPING_SPEED_MAX=150
MAX_FOLLOW_UPS=5
FOLLOW_UP_DAYS=7,14,21,28

# System Settings
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Safety — set to 'false' only when ready to go live (comments, DMs, follow-ups)
# Default is true (dry-run mode: generates & shows messages but does NOT send)
DRY_RUN=true
